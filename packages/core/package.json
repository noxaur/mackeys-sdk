{
  "name": "@mackeys/core",
  "version": "0.1.1",
  "description": "Mac keyboard and trackpad engine: geometry, themes, layouts, controllers and click sounds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxaur/mackeys-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/noxaur/mackeys-sdk#readme",
  "bugs": "https://github.com/noxaur/mackeys-sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
