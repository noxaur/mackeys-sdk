{
  "name": "@mackeys/svelte",
  "version": "0.2.0",
  "description": "Interactive Mac keyboards and Force Touch trackpads for Svelte 5.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxaur/mackeys-sdk.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/noxaur/mackeys-sdk#readme",
  "bugs": "https://github.com/noxaur/mackeys-sdk/issues",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@mackeys/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/svelte": "^5.2.0",
    "jsdom": "^25.0.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
