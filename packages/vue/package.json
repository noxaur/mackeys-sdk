{
  "name": "@mackeys/vue",
  "version": "0.1.1",
  "description": "Interactive Mac keyboards and Force Touch trackpads for Vue 3.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxaur/mackeys-sdk.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/noxaur/mackeys-sdk#readme",
  "bugs": "https://github.com/noxaur/mackeys-sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vue",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@mackeys/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0"
  }
}
